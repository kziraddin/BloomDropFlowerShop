# Django
SECRET_KEY=change-me
JWT_SECRET=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
PORT=5500

# CORS (production: list the Vercel domain instead of allowing all origins)
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# PostgreSQL (matches Implementation/docker-compose.yml)
POSTGRES_DB=bloomdrop
POSTGRES_USER=bloomdrop
POSTGRES_PASSWORD=bloomdrop
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Alternatively provide a single connection string (used by Render)
# DATABASE_URL=postgres://user:password@host:5432/dbname
